// Cloudflare Workers static-assets config. There is no Worker script:
// everything in ./public is served as-is.
{
  "name": "flayshon",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
